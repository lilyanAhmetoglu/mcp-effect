{
  "$schema": "../../schema/config.schema.json",
  "name": "shop-gateway",
  "upstreams": {
    "shop": { "command": "node", "args": ["../shop/shop-server.mjs"] }
  },
  "always": ["shop__get_order"],
  "rules": [
    {
      "name": "refunds",
      "when": { "order.status": "failed" },
      "tools": ["shop__refund_order", "shop__email_customer"],
      "hint": "Refund and email tools appear when an order has failed."
    }
  ],
  "http": {
    "port": 3000,
    "clients": [
      { "tokenEnv": "ALICE_TOKEN", "scope": "user:alice" },
      { "tokenEnv": "BOB_TOKEN", "scope": "user:bob" }
    ],
    "adminTokenEnv": "MCP_EFFECT_ADMIN_TOKEN"
  }
}
